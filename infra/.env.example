# ── Infrastructure ──────────────────────────────────────────────
# Values below target Docker Compose (service DNS).
# For Nest on the host (no compose), use localhost / localhost URLs instead.
POSTGRES_USER=roomly
POSTGRES_PASSWORD=roomly
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

RABBITMQ_USER=roomly
RABBITMQ_PASSWORD=roomly
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ── Database names (init SQL uses same names; apps read from here) ─
USER_DB_NAME=user_db
HOTEL_DB_NAME=hotel_db
BOOKING_DB_NAME=booking_db

# ── NestJS service ports ──────────────────────────────────────────
GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
NOTIFICATION_SERVICE_PORT=3002

# ── Python service ports (Vitalii; placeholders until services exist) ─
HOTEL_SERVICE_PORT=8000
BOOKING_SERVICE_PORT=8001

# ── Inter-service URLs (Docker DNS) ───────────────────────────────
USER_SERVICE_URL=http://user-service:3001
NOTIFICATION_SERVICE_URL=http://notification-service:3002
HOTEL_SERVICE_URL=http://hotel-service:8000
BOOKING_SERVICE_URL=http://booking-service:8001
GATEWAY_URL=http://localhost:3000

# ── Auth (RSA JWT / JWKS) ─────────────────────────────────────────
# Host Nest cwd: relative path. Compose user-service overrides via
# JWT_PRIVATE_KEY_PATH_DOCKER (/run/secrets/jwt/...).
JWT_PRIVATE_KEY_PATH=../../infra/secrets/dev/jwt-private.pem
JWT_PRIVATE_KEY_PATH_DOCKER=/run/secrets/jwt/jwt-private.pem
JWT_KEY_ID=roomly-dev-1
JWT_ISSUER=roomly-user-service
JWT_AUDIENCE=roomly-gateway
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Optional override; default = ${USER_SERVICE_URL}/.well-known/jwks.json
# JWKS_URI=http://user-service:3001/.well-known/jwks.json

# ── Gateway security ──────────────────────────────────────────────
# Comma-separated; use * for any origin (dev)
CORS_ORIGINS=*
# Max requests per IP within window
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
# Auth cookies (httpOnly). Secure defaults to true in production.
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax

# ── Tracing (OpenTelemetry → Jaeger) ──────────────────────────────
JAEGER_UI_PORT=16686
JAEGER_OTLP_HTTP_PORT=4318
JAEGER_OTLP_GRPC_PORT=4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# Batch export delay (ms). Default ~5000; lower for snappier Jaeger in local.
OTEL_BSP_SCHEDULE_DELAY=500
# OTEL_SDK_DISABLED=true

# ── Logs UI (Loki + Promtail + Grafana) ───────────────────────────
LOKI_PORT=3100
GRAFANA_PORT=3003
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
# GRAFANA_ROOT_URL=http://localhost:3003

# ── Metrics (Prometheus scrapes Nest /metrics) ────────────────────
PROMETHEUS_PORT=9090
# OTEL_METRICS_DISABLED=true

# ── Logging (nestjs-pino) ─────────────────────────────────────────
# LOG_LEVEL=info
# Pretty console breaks Promtail JSON parsing — leave unset/false when using Loki.
# LOG_PRETTY=true
