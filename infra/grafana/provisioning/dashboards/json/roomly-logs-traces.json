{
  "uid": "roomly-logs-traces",
  "title": "Logs & Traces (Loki + Tempo)",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 24,
  "refresh": "15s",
  "tags": [
    "roomly",
    "loki",
    "tempo",
    "logs",
    "traces"
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "trace_id",
        "type": "textbox",
        "label": "Trace ID",
        "description": "Filter logs / HTTP by trace ID. Leave empty to show all.",
        "query": "",
        "current": {
          "selected": true,
          "text": "",
          "value": ""
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "service",
        "type": "custom",
        "label": "Service",
        "query": "gateway,user-service,notification-service",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": "gateway|user-service|notification-service",
        "multi": true,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "How to correlate",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Trace ID** / **Service** (зверху): фільтр логів і HTTP.\n\n**Recent HTTP → Trace ID:** Tempo + Nest/Redis/RabbitMQ/Postgres (±5m, запит у центрі; червона мітка HTTP request на графіках).\n\nЛоги: Nest OTLP → Collector → Loki. Body — повний pino JSON (`| json`)."
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log volume / s (by service)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (compose_service) (rate({compose_service=~\"$service\"} |= `$trace_id`[1m]))",
          "legendFormat": "{{compose_service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Warn + error log rate",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 3
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (compose_service) (rate({compose_service=~\"$service\"} |= `$trace_id` | json | level=~\"(40|50|warn|error|WARN|ERROR)\" [1m]))",
          "legendFormat": "{{compose_service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Recent HTTP (Status + Trace ID)",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{collector_name=\"roomly-otel-collector\", compose_service=~\"$service\"} |= `$trace_id` | json | res_statusCode != \"\" | line_format `{\"service\":\"{{.compose_service}}\",\"method\":\"{{.req_method}}\",\"path\":\"{{.req_url}}\",\"status\":{{.res_statusCode}},\"ms\":{{.responseTime}},\"trace_id\":\"{{.trace_id}}\",\"from_ms\":{{ sub (__timestamp__ | unixEpochMillis) 300000 }},\"to_ms\":{{ add (__timestamp__ | unixEpochMillis) 300000 }}}`",
          "queryType": "range",
          "maxLines": 100
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "keepTime": true,
            "replace": true
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Time",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true,
              "labels": true,
              "tsNs": true,
              "id": true
            },
            "indexByName": {
              "Time": 0,
              "service": 1,
              "method": 2,
              "path": 3,
              "status": 4,
              "ms": 5,
              "trace_id": 6,
              "from_ms": 7,
              "to_ms": 8
            },
            "renameByName": {}
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "service"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Service"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Status"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 400
                    },
                    {
                      "color": "red",
                      "value": 500
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "method"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Method"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "path"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Path"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ms"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "trace_id"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Trace ID"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "View trace",
                    "url": "/explore?orgId=1&left=%7B%22datasource%22:%22tempo%22,%22queries%22:%5B%7B%22query%22:%22${__value.raw}%22,%22queryType%22:%22traceql%22%7D%5D%7D",
                    "targetBlank": false
                  },
                  {
                    "title": "Nest metrics (±5m)",
                    "url": "/d/roomly-nest?orgId=1&var-trace_id=${__data.fields.trace_id}&from=${__data.fields.from_ms}&to=${__data.fields.to_ms}&var-service=${__data.fields.service}",
                    "targetBlank": false
                  },
                  {
                    "title": "Redis (±5m)",
                    "url": "/d/roomly-redis?orgId=1&var-trace_id=${__data.fields.trace_id}&from=${__data.fields.from_ms}&to=${__data.fields.to_ms}",
                    "targetBlank": false
                  },
                  {
                    "title": "RabbitMQ (±5m)",
                    "url": "/d/roomly-rabbitmq?orgId=1&var-trace_id=${__data.fields.trace_id}&from=${__data.fields.from_ms}&to=${__data.fields.to_ms}",
                    "targetBlank": false
                  },
                  {
                    "title": "Postgres (±5m)",
                    "url": "/d/roomly-postgres?orgId=1&var-trace_id=${__data.fields.trace_id}&from=${__data.fields.from_ms}&to=${__data.fields.to_ms}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "from_ms"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "to_ms"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Recent Nest logs",
      "gridPos": {
        "h": 14,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{compose_service=~\"$service\"} |= `$trace_id` | json"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Errors / warnings only",
      "gridPos": {
        "h": 14,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{compose_service=~\"$service\"} |= `$trace_id` | json | level=~\"(40|50|warn|error|WARN|ERROR)\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
