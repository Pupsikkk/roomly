{
  "uid": "roomly-logs-traces",
  "title": "Logs & Traces (Loki + Tempo)",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 9,
  "refresh": "15s",
  "tags": [
    "roomly",
    "loki",
    "tempo",
    "logs",
    "traces"
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "trace_id",
        "type": "textbox",
        "label": "Trace ID",
        "description": "Filter logs / HTTP by trace ID. Leave empty to show all.",
        "query": "",
        "current": {
          "selected": true,
          "text": "",
          "value": ""
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "service",
        "type": "custom",
        "label": "Service",
        "query": "gateway,user-service,notification-service",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": "gateway|user-service|notification-service",
        "multi": true,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "How to correlate",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Trace ID** (зверху): фільтр логів / HTTP.\n\n**Logs → Trace:** **View trace** біля `trace_id` (Grafana Explore / Tempo).\n\nЛоги: Nest OTLP → Collector → Loki (`collector.name=roomly-otel-collector`). Body — повний pino JSON (`| json`). Stdout лише для консолі."
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log volume / s (by service)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (compose_service) (rate({compose_service=~\"$service\"} |= `$trace_id`[1m]))",
          "legendFormat": "{{compose_service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Warn + error log rate",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 3
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (compose_service) (rate({compose_service=~\"$service\"} |= `$trace_id` | json | level=~\"(40|50|warn|error|WARN|ERROR)\" [1m]))",
          "legendFormat": "{{compose_service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Recent Nest logs",
      "gridPos": {
        "h": 14,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{compose_service=~\"$service\"} |= `$trace_id` | json"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Errors / warnings only",
      "gridPos": {
        "h": 14,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{compose_service=~\"$service\"} |= `$trace_id` | json | level=~\"(40|50|warn|error|WARN|ERROR)\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Recent HTTP — gateway (Status + Trace ID)",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{collector_name=\"roomly-otel-collector\", compose_service=\"gateway\"} |= `$trace_id` | json | res_statusCode != \"\" | line_format \"{\\\"method\\\":\\\"{{.req_method}}\\\",\\\"path\\\":\\\"{{.req_url}}\\\",\\\"status\\\":{{.res_statusCode}},\\\"ms\\\":{{.responseTime}},\\\"trace_id\\\":\\\"{{.trace_id}}\\\"}\"",
          "queryType": "range",
          "maxLines": 50
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "keepTime": true,
            "replace": true
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Time",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true,
              "labels": true,
              "tsNs": true,
              "id": true
            },
            "indexByName": {
              "Time": 0,
              "method": 1,
              "path": 2,
              "status": 3,
              "ms": 4,
              "trace_id": 5
            },
            "renameByName": {}
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Status"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 400
                    },
                    {
                      "color": "red",
                      "value": 500
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "method"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Method"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "path"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Path"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ms"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "trace_id"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Trace ID"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "View trace",
                    "url": "/explore?orgId=1&left=%7B%22datasource%22:%22tempo%22,%22queries%22:%5B%7B%22query%22:%22${__value.raw}%22,%22queryType%22:%22traceql%22%7D%5D%7D",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      }
    },
