.env
infra/.env

# Local Docker volume data (never commit)
infra/postgres/data/**
!infra/postgres/data/.gitkeep
infra/redis/data/**
!infra/redis/data/.gitkeep
infra/rabbitmq/data/**
!infra/rabbitmq/data/.gitkeep
infra/loki/data/**
!infra/loki/data/.gitkeep
infra/grafana/data/**
!infra/grafana/data/.gitkeep

# Dev JWT signing keys (generate locally: npm run auth:keys)
infra/secrets/**/*.pem

