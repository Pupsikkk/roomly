.env
infra/.env
infra/secrets/.env

# Local Docker volume data (never commit)
infra/postgres/data/**
!infra/postgres/data/.gitkeep
infra/redis/data/**
!infra/redis/data/.gitkeep
infra/rabbitmq/data/**
!infra/rabbitmq/data/.gitkeep
infra/loki/data/**
!infra/loki/data/.gitkeep
infra/grafana/data/**
!infra/grafana/data/.gitkeep
infra/prometheus/data/**
!infra/prometheus/data/.gitkeep
infra/tempo/data/**
!infra/tempo/data/.gitkeep

# Dev JWT signing keys (generate locally: npm run auth:keys)
infra/secrets/**/*.pem

.DS_Store
node_modules/
# Root package.json is scripts-only (no deps) — ignore accidental lockfile.
# backend/js/package-lock.json stays tracked.
/package-lock.json
dist/
build/
coverage/
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.idea/
.vscode/
*.log
