# Dev image: full deps, source mounted via compose for nest --watch
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY docker-entrypoint.dev.sh /usr/local/bin/roomly-dev-entrypoint
RUN chmod +x /usr/local/bin/roomly-dev-entrypoint
ENTRYPOINT ["roomly-dev-entrypoint"]
# apps/libs/configs are bind-mounted at runtime (see docker-compose.dev.yml)
