{
  "name": "roomly-js",
  "version": "0.0.1",
  "description": "Roomly NestJS monorepo — gateway, user-service, notification-service",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build gateway && nest build user-service && nest build notification-service",
    "build:gateway": "nest build gateway",
    "build:user": "nest build user-service",
    "build:notification": "nest build notification-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start gateway",
    "start:gateway": "nest start gateway",
    "start:user": "nest start user-service",
    "start:notification": "nest start notification-service",
    "start:dev": "nest start gateway --watch",
    "start:dev:gateway": "nest start gateway --watch",
    "start:dev:user": "nest start user-service --watch",
    "start:dev:notification": "nest start notification-service --watch",
    "start:debug": "nest start gateway --debug --watch",
    "start:prod:gateway": "node dist/apps/gateway/main",
    "start:prod:user": "node dist/apps/user-service/main",
    "start:prod:notification": "node dist/apps/notification-service/main",
    "typeorm": "TS_NODE_PROJECT=tsconfig.typeorm.json typeorm-ts-node-commonjs",
    "migration:run:user": "npm run typeorm -- migration:run -d apps/user-service/src/adapters/outbound/persistence/typeorm/data-source.ts",
    "migration:revert:user": "npm run typeorm -- migration:revert -d apps/user-service/src/adapters/outbound/persistence/typeorm/data-source.ts",
    "migration:show:user": "npm run typeorm -- migration:show -d apps/user-service/src/adapters/outbound/persistence/typeorm/data-source.ts",
    "migration:generate:user": "npm run typeorm -- migration:generate apps/user-service/src/adapters/outbound/persistence/typeorm/migrations/Migration -d apps/user-service/src/adapters/outbound/persistence/typeorm/data-source.ts",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-prometheus": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/host-metrics": "^0.38.3",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "amqplib": "^2.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.2.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/pino-http": "^5.8.4",
    "@types/supertest": "^7.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@roomly/common(.*)$": "<rootDir>/libs/common/src$1",
      "^@roomly/infra(.*)$": "<rootDir>/libs/infra/src$1",
      "^@roomly/contracts(.*)$": "<rootDir>/libs/contracts/src$1"
    }
  },
  "optionalDependencies": {
    "pino-pretty": "^13.1.3"
  }
}
